@model IEnumerable<LibraryManagementSystem.Models.Member>
@{
    ViewData["Title"] = "Members Registry";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="text-gradient mb-0 font-weight-800">Members Registry</h1>
        <p class="text-muted mb-0">Manage registered library members and borrowing privileges</p>
    </div>
    <a href="/Members/Create" class="btn btn-gradient">
        <i class="fa-solid fa-user-plus me-2"></i>Register New Member
    </a>
</div>

<!-- Filters & Search Bar -->
<div class="glass-card mb-4 py-3 px-4">
    <form method="get" asp-action="Index" class="row g-3 align-items-center">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-transparent border-end-0 text-muted" style="border: 1px solid var(--glass-border); border-top-left-radius: 12px; border-bottom-left-radius: 12px;">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </span>
                <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control form-glass border-start-0" style="border-top-left-radius: 0; border-bottom-left-radius: 0;" placeholder="Search by Name, Email, Phone..." />
            </div>
        </div>
        <div class="col-md-4">
            <select name="statusFilter" class="form-select form-glass">
                <option value="">All Statuses</option>
                <!---->
                @if (ViewBag.CurrentStatus == "Active")
                {
                    <option value="Active" selected>Active</option>
                    <option value="Suspended">Suspended</option>
                }
                else if (ViewBag.CurrentStatus == "Suspended")
                {
                    <option value="Active">Active</option>
                    <option value="Suspended" selected>Suspended</option>
                }
                else
                {
                    <option value="Active">Active</option>
                    <option value="Suspended">Suspended</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-glass flex-grow-1">Filter</button>
            <a href="/Members" class="btn btn-glass"><i class="fa-solid fa-rotate-left"></i></a>
        </div>
    </form>
</div>

<!-- Members Table -->
<div class="glass-card p-0">
    <div class="table-responsive">
        <table class="table glass-table">
            <thead>
                <tr>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Registered On</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-user-slash fs-2 mb-3"></i>
                            <p class="mb-0">No members found matching parameters.</p>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="font-weight-600 text-white">@item.FullName</div>
                                <div class="text-muted fs-7">Member ID: #@item.Id</div>
                            </td>
                            <td>@item.Email</td>
                            <td>@item.PhoneNumber</td>
                            <td>@item.JoinDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                @if (item.Status == "Active")
                                {
                                    <span class="badge-custom badge-active">Active</span>
                                }
                                else
                                {
                                    <span class="badge-custom badge-suspended">Suspended</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <a href="/Members/Details/@item.Id" class="btn btn-sm btn-glass px-2" title="View Profile">
                                        <i class="fa-solid fa-address-card text-primary"></i>
                                    </a>
                                    <a href="/Members/Edit/@item.Id" class="btn btn-sm btn-glass px-2" title="Edit details">
                                        <i class="fa-solid fa-pen text-warning"></i>
                                    </a>
                                    
                                    <!-- Suspend / Unsuspend action -->
                                    <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @if (item.Status == "Active")
                                        {
                                            <button type="submit" class="btn btn-sm btn-glass px-2" title="Suspend Member">
                                                <i class="fa-solid fa-user-slash text-danger"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-glass px-2" title="Activate Member">
                                                <i class="fa-solid fa-user-check text-success"></i>
                                            </button>
                                        }
                                    </form>

                                    <!-- Delete profile -->
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this member registration?');" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-glass px-2" title="Delete record">
                                            <i class="fa-solid fa-trash text-danger"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
