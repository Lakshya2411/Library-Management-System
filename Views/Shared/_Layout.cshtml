<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lakshya Library</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LibraryManagementSystem.styles.css" asp-append-version="true" />
</head>
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
}
<body>
    <div class="app-container">
        <!-- Sidebar Navigation -->
        <aside class="sidebar">
            <a href="/" class="sidebar-brand">
                <i class="fa-solid fa-book-open-reader"></i>
                <span>Lakshya Library</span>
            </a>
            
            <ul class="sidebar-menu">
                <li>
                    <a href="/" class="sidebar-link @(currentController == "Home" ? "active" : "")">
                        <i class="fa-solid fa-chart-pie"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li>
                    <a href="/Books" class="sidebar-link @(currentController == "Books" ? "active" : "")">
                        <i class="fa-solid fa-book"></i>
                        <span>Book Catalog</span>
                    </a>
                </li>
                <li>
                    <a href="/Members" class="sidebar-link @(currentController == "Members" ? "active" : "")">
                        <i class="fa-solid fa-users"></i>
                        <span>Members</span>
                    </a>
                </li>
                <li>
                    <a href="/Loans" class="sidebar-link @(currentController == "Loans" ? "active" : "")">
                        <i class="fa-solid fa-handshake"></i>
                        <span>Borrow / Return</span>
                    </a>
                </li>
            </ul>
        </aside>

        <!-- Main Workspace -->
        <main class="main-content">
            <!-- Toast notification messages -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-custom alert-success-custom alert-dismissible fade show mb-4" role="alert">
                    <i class="fa-solid fa-circle-check me-2 text-success"></i>
                    @TempData["Success"]
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-custom alert-danger-custom alert-dismissible fade show mb-4" role="alert">
                    <i class="fa-solid fa-circle-exclamation me-2 text-danger"></i>
                    @TempData["Error"]
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
