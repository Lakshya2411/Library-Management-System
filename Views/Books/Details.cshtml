@model LibraryManagementSystem.Models.Book
@{
    ViewData["Title"] = "Book Details";
    var loans = ViewBag.Loans as List<LibraryManagementSystem.Models.Loan> ?? new List<LibraryManagementSystem.Models.Loan>();
}

<div class="mb-4">
    <a href="/Books" class="btn btn-sm btn-glass mb-3"><i class="fa-solid fa-arrow-left me-2"></i>Back to Catalog</a>
    <h1 class="text-gradient mb-0 font-weight-800">Book Information</h1>
    <p class="text-muted">Viewing catalog records for @Model.Title</p>
</div>

<div class="row g-4">
    <!-- Meta Details Card -->
    <div class="col-lg-5">
        <div class="glass-card d-flex flex-column h-100 justify-content-between gap-4">
            <div>
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <span class="badge bg-primary px-3 py-2">@Model.Genre</span>
                    <div class="text-end">
                        <span class="fs-7 text-muted">ISBN</span>
                        <div class="font-weight-600">@Model.ISBN</div>
                    </div>
                </div>

                <h2 class="text-white mb-1">@Model.Title</h2>
                <h5 class="text-muted mb-4">by @Model.Author</h5>

                <div class="d-flex flex-column gap-3">
                    <div class="d-flex justify-content-between border-bottom border-secondary pb-2">
                        <span class="text-secondary font-weight-500">Publisher</span>
                        <span class="text-white">@Model.Publisher</span>
                    </div>
                    <div class="d-flex justify-content-between border-bottom border-secondary pb-2">
                        <span class="text-secondary font-weight-500">Publish Year</span>
                        <span class="text-white">@Model.PublishYear</span>
                    </div>
                    <div class="d-flex justify-content-between border-bottom border-secondary pb-2">
                        <span class="text-secondary font-weight-500">Total Stock</span>
                        <span class="text-white">@Model.TotalCopies Copies</span>
                    </div>
                    <div class="d-flex justify-content-between pb-2">
                        <span class="text-secondary font-weight-500">Available Stock</span>
                        <span class="text-white font-weight-700">@Model.AvailableCopies Copies</span>
                    </div>
                </div>
            </div>

            <!-- Availability status visual meter -->
            <div>
                <div class="d-flex justify-content-between fs-7 text-muted mb-2">
                    <span>Shelf Availability</span>
                    <span>@((double)Model.AvailableCopies / Model.TotalCopies * 100)% Available</span>
                </div>
                <div class="progress" style="height: 10px; background: rgba(255, 255, 255, 0.05); border-radius: 999px;">
                    <div class="progress-bar bg-primary" role="progressbar" 
                         style="width: @((double)Model.AvailableCopies / Model.TotalCopies * 100)%; border-radius: 999px;" 
                         aria-valuenow="@Model.AvailableCopies" aria-valuemin="0" aria-valuemax="@Model.TotalCopies"></div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-2">
                <a href="/Books/Edit/@Model.Id" class="btn btn-glass flex-grow-1"><i class="fa-solid fa-pen me-2 text-warning"></i>Edit Details</a>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this book?');" class="flex-grow-1">
                    <button type="submit" class="btn btn-glass w-100"><i class="fa-solid fa-trash me-2 text-danger"></i>Delete</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Loan logs of the book -->
    <div class="col-lg-7">
        <div class="glass-card h-100">
            <h4 class="mb-3 text-white"><i class="fa-solid fa-clock-rotate-left me-2 text-primary"></i>Borrowing History Log</h4>
            
            <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                <table class="table glass-table">
                    <thead>
                        <tr>
                            <th>Borrower</th>
                            <th>Issued On</th>
                            <th>Due Date</th>
                            <th>Returned On</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!loans.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-history fs-3 mb-2"></i>
                                    <p class="mb-0">No transaction history recorded for this book.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var loan in loans)
                            {
                                <tr>
                                    <td>
                                        <a href="/Members/Details/@loan.MemberId" class="text-white font-weight-500 text-decoration-none">
                                            @loan.Member?.FullName
                                        </a>
                                    </td>
                                    <td>@loan.IssueDate.ToString("yyyy-MM-dd")</td>
                                    <td>@loan.DueDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        @(loan.ReturnDate.HasValue ? loan.ReturnDate.Value.ToString("yyyy-MM-dd") : "-")
                                    </td>
                                    <td>
                                        @if (loan.IsReturned)
                                        {
                                            <span class="badge-custom badge-returned">Returned</span>
                                        }
                                        else if (loan.IsOverdue)
                                        {
                                            <span class="badge-custom badge-overdue">Overdue</span>
                                        }
                                        else
                                        {
                                            <span class="badge-custom badge-active">Active</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
