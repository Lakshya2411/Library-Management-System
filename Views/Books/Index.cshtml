@model IEnumerable<LibraryManagementSystem.Models.Book>
@{
    ViewData["Title"] = "Book Catalog";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="text-gradient mb-0 font-weight-800">Book Catalog</h1>
        <p class="text-muted mb-0">Browse and manage the library's physical book collection</p>
    </div>
    <a href="/Books/Create" class="btn btn-gradient">
        <i class="fa-solid fa-plus me-2"></i>Add New Book
    </a>
</div>

<!-- Filters & Search Bar -->
<div class="glass-card mb-4 py-3 px-4">
    <form method="get" asp-action="Index" class="row g-3 align-items-center">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-transparent border-end-0 text-muted" style="border: 1px solid var(--glass-border); border-top-left-radius: 12px; border-bottom-left-radius: 12px;">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </span>
                <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control form-glass border-start-0" style="border-top-left-radius: 0; border-bottom-left-radius: 0;" placeholder="Search by Title, Author, ISBN..." />
            </div>
        </div>
        <div class="col-md-4">
            <select name="genreFilter" class="form-select form-glass">
                <option value="">All Genres</option>
                @if (ViewBag.Genres != null)
                {
                    foreach (var genre in ViewBag.Genres)
                    {
                        if (genre == ViewBag.CurrentGenre)
                        {
                            <option value="@genre" selected>@genre</option>
                        }
                        else
                        {
                            <option value="@genre">@genre</option>
                        }
                    }
                }
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-glass flex-grow-1">Filter</button>
            <a href="/Books" class="btn btn-glass"><i class="fa-solid fa-rotate-left"></i></a>
        </div>
    </form>
</div>

<!-- Book Catalog Table -->
<div class="glass-card p-0">
    <div class="table-responsive">
        <table class="table glass-table">
            <thead>
                <tr>
                    <th>Title / Author</th>
                    <th>ISBN</th>
                    <th>Genre</th>
                    <th>Publish Year</th>
                    <th>Availability</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-circle-question fs-2 mb-3"></i>
                            <p class="mb-0">No books found matching search filters.</p>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="font-weight-600 text-white">@item.Title</div>
                                <div class="text-muted fs-7">@item.Author</div>
                            </td>
                            <td>
                                <code class="text-light">@item.ISBN</code>
                            </td>
                            <td>
                                <span class="badge bg-secondary">@item.Genre</span>
                            </td>
                            <td>
                                @item.PublishYear
                            </td>
                            <td>
                                @if (item.AvailableCopies == 0)
                                {
                                    <span class="badge-custom badge-suspended">Out of Stock</span>
                                }
                                else
                                {
                                    <span class="badge-custom badge-active">@item.AvailableCopies of @item.TotalCopies Copies</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <a href="/Books/Details/@item.Id" class="btn btn-sm btn-glass px-2" title="Details">
                                        <i class="fa-solid fa-eye text-primary"></i>
                                    </a>
                                    <a href="/Books/Edit/@item.Id" class="btn btn-sm btn-glass px-2" title="Edit">
                                        <i class="fa-solid fa-pen text-warning"></i>
                                    </a>
                                    
                                    <!-- Delete form confirmation -->
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this book?');" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-glass px-2" title="Delete">
                                            <i class="fa-solid fa-trash text-danger"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
