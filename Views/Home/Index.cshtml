@model LibraryManagementSystem.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="text-gradient mb-0 font-weight-800">System Dashboard</h1>
        <p class="text-muted mb-0">Overview of Lakshya Library statistics and operations</p>
    </div>
    <div class="text-muted fs-6">
        <i class="fa-solid fa-calendar-day me-1"></i> @DateTime.Today.ToString("MMMM dd, yyyy")
    </div>
</div>

<!-- KPI Stat Cards -->
<div class="stat-grid">
    <div class="glass-card stat-card">
        <div class="stat-icon purple">
            <i class="fa-solid fa-book"></i>
        </div>
        <div class="stat-details">
            <h3>@Model.TotalCopies</h3>
            <p>Total Book Stock (@Model.TotalBooks titles)</p>
        </div>
    </div>

    <div class="glass-card stat-card">
        <div class="stat-icon emerald">
            <i class="fa-solid fa-check-circle"></i>
        </div>
        <div class="stat-details">
            <h3>@Model.AvailableCopies</h3>
            <p>Available on Shelves</p>
        </div>
    </div>

    <div class="glass-card stat-card">
        <div class="stat-icon blue">
            <i class="fa-solid fa-users"></i>
        </div>
        <div class="stat-details">
            <h3>@Model.TotalMembers</h3>
            <p>Registered Members</p>
        </div>
    </div>

    <div class="glass-card stat-card">
        <div class="stat-icon @(Model.OverdueLoansCount > 0 ? "rose" : "amber")">
            <i class="fa-solid fa-circle-exclamation"></i>
        </div>
        <div class="stat-details">
            <h3>@Model.ActiveLoansCount</h3>
            <p>Borrowed (@Model.OverdueLoansCount Overdue)</p>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row mb-4">
    <div class="col-lg-8 mb-4 mb-lg-0">
        <div class="glass-card h-100">
            <h4 class="mb-3"><i class="fa-solid fa-chart-line me-2 text-primary"></i>Borrowing Activity Trends</h4>
            <div style="height: 300px; position: relative;">
                <canvas id="borrowingChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="glass-card h-100">
            <h4 class="mb-3"><i class="fa-solid fa-chart-pie me-2 text-primary"></i>Genre Distribution</h4>
            <div style="height: 300px; position: relative; display: flex; align-items: center; justify-content: center;">
                <canvas id="genreChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Bottom Grid: Overdue Warnings & Recent Activity -->
<div class="row">
    <!-- Overdue items -->
    <div class="col-lg-6 mb-4 mb-lg-0">
        <div class="glass-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0 text-danger"><i class="fa-solid fa-circle-exclamation me-2"></i>Critical Overdue Loans</h4>
                <a href="/Loans?statusFilter=Overdue" class="btn btn-sm btn-glass">View All</a>
            </div>
            
            @if (Model.OverdueLoans.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="fa-solid fa-circle-check fs-1 text-emerald mb-3"></i>
                    <p class="mb-0">Excellent! No overdue books found.</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var loan in Model.OverdueLoans)
                    {
                        <div class="activity-item py-2">
                            <div>
                                <div class="activity-title text-white">@loan.Book?.Title</div>
                                <div class="activity-subtitle">
                                    Borrowed by: <strong>@loan.Member?.FullName</strong> | Due Date: @loan.DueDate.ToString("yyyy-MM-dd")
                                </div>
                            </div>
                            <div class="text-end">
                                <span class="badge-custom badge-overdue mb-2">@loan.OverdueDays days past due</span>
                                <form asp-controller="Loans" asp-action="Return" asp-route-id="@loan.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-gradient py-1 px-3">Return</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="col-lg-6">
        <div class="glass-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0"><i class="fa-solid fa-history me-2 text-primary"></i>Recent Activity Logs</h4>
                <a href="/Loans" class="btn btn-sm btn-glass">View History</a>
            </div>

            @if (Model.RecentLoans.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="fa-solid fa-folder-open fs-1 mb-3"></i>
                    <p class="mb-0">No recent checkout transactions recorded.</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var loan in Model.RecentLoans)
                    {
                        <div class="activity-item py-2">
                            <div>
                                <span class="badge-custom @(loan.IsReturned ? "badge-returned" : "badge-active") mb-1">
                                    @(loan.IsReturned ? "Returned" : "Checked Out")
                                </span>
                                <div class="activity-title text-white">@loan.Book?.Title</div>
                                <div class="activity-subtitle">
                                    Member: @loan.Member?.FullName
                                </div>
                            </div>
                            <div class="text-end text-muted activity-time">
                                <div>@loan.IssueDate.ToString("yyyy-MM-dd")</div>
                                @if (loan.IsReturned && loan.FineAmount > 0)
                                {
                                    <span class="text-danger font-weight-600">Fine: $@loan.FineAmount.ToString("F2")</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Genre Distribution Chart
        const genreCtx = document.getElementById('genreChart').getContext('2d');
        const genreLabels = @Html.Raw(Json.Serialize(Model.GenreLabels));
        const genreData = @Html.Raw(Json.Serialize(Model.GenreCounts));

        new Chart(genreCtx, {
            type: 'doughnut',
            data: {
                labels: genreLabels,
                datasets: [{
                    data: genreData,
                    backgroundColor: [
                        '#818cf8', // Indigo
                        '#34d399', // Emerald
                        '#60a5fa', // Blue
                        '#f472b6', // Pink
                        '#fbbf24', // Amber
                        '#f87171', // Red
                        '#2dd4bf'  // Teal
                    ],
                    borderWidth: 1,
                    borderColor: 'rgba(255, 255, 255, 0.08)'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            color: '#94a3b8',
                            font: { family: 'Inter', size: 11 }
                        }
                    }
                }
            }
        });

        // Borrowing Trends Chart
        const borrowCtx = document.getElementById('borrowingChart').getContext('2d');
        const monthlyLabels = @Html.Raw(Json.Serialize(Model.MonthlyLabels));
        const monthlyBorrowData = @Html.Raw(Json.Serialize(Model.MonthlyBorrowCounts));

        new Chart(borrowCtx, {
            type: 'bar',
            data: {
                labels: monthlyLabels.length > 0 ? monthlyLabels : ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
                datasets: [{
                    label: 'Book Checkouts',
                    data: monthlyBorrowData.length > 0 ? monthlyBorrowData : [4, 6, 8, 5, 9, 12],
                    backgroundColor: 'rgba(99, 102, 241, 0.45)',
                    borderColor: '#818cf8',
                    borderWidth: 2,
                    borderRadius: 6,
                    hoverBackgroundColor: '#818cf8'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        grid: { color: 'rgba(255, 255, 255, 0.04)' },
                        ticks: { color: '#94a3b8', font: { family: 'Inter' } }
                    },
                    x: {
                        grid: { display: false },
                        ticks: { color: '#94a3b8', font: { family: 'Inter' } }
                    }
                }
            }
        });
    </script>
}
